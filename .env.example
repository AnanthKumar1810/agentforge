# Choose ollama for a local open-weight model, or openai for hosted models.
AGENTFORGE_PROVIDER=ollama
AGENTFORGE_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1/
AGENTFORGE_MODEL=qwen3:8b
AGENTFORGE_VALIDATOR=docker
AGENTFORGE_API_TOKEN=
# Only required when AGENTFORGE_PROVIDER=openai
OPENAI_API_KEY=
AGENTFORGE_DATA_DIR=.agentforge-data
AGENTFORGE_MAX_REPAIR_ROUNDS=2
AGENTFORGE_VALIDATION_TIMEOUT_SECONDS=90
AGENTFORGE_MAX_FILE_BYTES=500000

# Optional integrations
AGENTFORGE_CREWAI_MODEL=gpt-5-mini
AGENTFORGE_BEEAI_MODEL=ollama:granite4.1:8b
AGENTFORGE_MCP_HOST=127.0.0.1
AGENTFORGE_MCP_PORT=8001
AGENTFORGE_WORKSPACE_MCP_HOST=127.0.0.1
AGENTFORGE_WORKSPACE_MCP_PORT=8003
# Shared data root for workspace-mcp --routed (defaults to AGENTFORGE_DATA_DIR)
# AGENTFORGE_MCP_WORKSPACE_ROOT=.agentforge-data

# AgntID runtime integration (https://github.com/AGNTID-AI/agntid-python)
# Modes: off | mcp | mock
AGENTFORGE_AGNTID_MODE=off
AGNTID_MCP_URL=http://localhost:8082/mcp
# Optional raw OAuth access token when runtime enforces OAuth (no "Bearer " prefix)
AGNTID_ACCESS_TOKEN=
AGNTID_AGENT_ID=agentforge-coding-agent:v1
AGNTID_USER_ID=local-operator
AGENTFORGE_AGNTID_TIMEOUT_SECONDS=10.0
AGENTFORGE_AGNTID_TOOL_PREFIX=
