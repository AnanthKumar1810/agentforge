# Required for core OpenAI Agents SDK runtime
OPENAI_API_KEY=
AGENTFORGE_MODEL=gpt-5-mini
AGENTFORGE_DATA_DIR=.agentforge-data
AGENTFORGE_MAX_REPAIR_ROUNDS=2
AGENTFORGE_VALIDATION_TIMEOUT_SECONDS=90
AGENTFORGE_MAX_FILE_BYTES=500000

# Optional integrations
AGENTFORGE_CREWAI_MODEL=gpt-5-mini
AGENTFORGE_BEEAI_MODEL=ollama:granite4.1:8b
AGENTFORGE_MCP_HOST=127.0.0.1
AGENTFORGE_MCP_PORT=8001
