# Choose ollama for a local open-weight model, or openai for hosted models.
AGENTFORGE_PROVIDER=ollama
AGENTFORGE_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1/
AGENTFORGE_MODEL=qwen3:8b
AGENTFORGE_VALIDATOR=docker
AGENTFORGE_API_TOKEN=
# Only required when AGENTFORGE_PROVIDER=openai
OPENAI_API_KEY=
AGENTFORGE_DATA_DIR=.agentforge-data
AGENTFORGE_MAX_REPAIR_ROUNDS=2
AGENTFORGE_VALIDATION_TIMEOUT_SECONDS=90
AGENTFORGE_MAX_FILE_BYTES=500000

# Optional integrations
AGENTFORGE_CREWAI_MODEL=gpt-5-mini
AGENTFORGE_BEEAI_MODEL=ollama:granite4.1:8b
AGENTFORGE_MCP_HOST=127.0.0.1
AGENTFORGE_MCP_PORT=8001

# Flip the Switch: set after registering a custom agent and creating a room.
SWITCH_BRIDGE_URL=http://127.0.0.1:8000
SWITCH_AGENT_ID=
SWITCH_AGENT_API_KEY=
SWITCH_ROOM_ID=
SWITCH_APPROVER_ID=
AGENTFORGE_SOURCE_REPO=
# Use an absolute directory outside AGENTFORGE_SOURCE_REPO.
AGENTFORGE_SWITCH_STATE_DIR=
